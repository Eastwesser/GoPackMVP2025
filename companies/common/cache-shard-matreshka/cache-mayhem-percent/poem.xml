<?xml version="1.0" encoding="UTF-8"?>
<poem>
    <title>Спокойная водная гладь</title>
    <stanza>
        <line>Стремительно по набережной пронесется,</line>
        <line>Укрывшись грациозно белою волной,</line>
        <line>Та птица встрепенется и назад вернется,</line>
        <line>Услышать чтобы вновь вдали родной прибой.</line>
    </stanza>
</poem>